    {"label":"Lua: 选择单测","type":"process","command":"pwsh","args":["-NoProfile","-File","${workspaceFolder}/tools/run.ps1","-Suite","${input:suite}"],"group":{"kind":"test","isDefault":true},"problemMatcher":[]},
    {"label":"Lua: 多人验证","type":"process","command":"pwsh","args":["-NoProfile","-File","${workspaceFolder}/tools/run.ps1","-Suite","${input:suite}","-Clients","${input:clients}"],"problemMatcher":[]},
    {"label":"Lua: 故意 OOS 对照（预期失败）","type":"process","command":"pwsh","args":["-NoProfile","-File","${workspaceFolder}/tools/run.ps1","-Mode","OOS","-Clients","3"],"problemMatcher":[]},
    {"label":"Lua: 30分钟压力测试","type":"process","command":"pwsh","args":["-NoProfile","-File","${workspaceFolder}/tools/run.ps1","-Mode","Soak","-Clients","3"],"problemMatcher":[]}
